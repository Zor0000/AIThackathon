# Copy this file to .env and fill in only the services you use.
APP_ENV=development
SOURCE_MODE=fixture
DATABASE_PATH=./data/groundtruth.db
APP_SECRET_KEY=replace-with-a-random-value

LLM_PROVIDER=google
LLM_MODEL=gemini-3.7-flash
GEMINI_API_KEY=

GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_ALLOWED_REPOSITORIES=your-account/demo-repository

JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_ALLOWED_PROJECTS=GT
