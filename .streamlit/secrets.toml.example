# Streamlit Cloud Secrets template. Set SOURCE_MODE to "fixture" for the demo.
# The FastAPI webhook service needs the same secrets in its deployment platform.
APP_ENV = "production"
SOURCE_MODE = "fixture"
APP_SECRET_KEY = "replace-with-a-long-random-value"
PUBLIC_BASE_URL = "https://your-public-api.example.com"

DATABASE_URL = "postgresql+psycopg://verisure:change-me@db.example.com:5432/verisure"
REDIS_URL = "redis://:change-me@redis.example.com:6379/0"
RQ_QUEUE_NAME = "verification"
RQ_DEFAULT_TIMEOUT_SECONDS = "300"

TWILIO_ACCOUNT_SID = ""
TWILIO_AUTH_TOKEN = ""
TWILIO_WHATSAPP_FROM = "whatsapp:+14155238886"
TWILIO_MESSAGING_SERVICE_SID = ""
TWILIO_VALIDATE_SIGNATURE = "true"
TWILIO_STATUS_CALLBACK_PATH = "/webhooks/twilio/status"
TWILIO_INBOUND_WEBHOOK_PATH = "/webhooks/twilio/whatsapp"

LLM_PROVIDER = "openai"
LLM_MODEL = ""
OPENAI_API_KEY = ""

VERIFICATION_MAX_SEND_ATTEMPTS = "3"
VERIFICATION_REMINDER_AFTER_HOURS = "24"
VERIFICATION_RESPONSE_TIMEOUT_HOURS = "48"
