# Copy this file to .env. Fixture mode is the only safe default for the demo.
APP_ENV=development
SOURCE_MODE=fixture
APP_SECRET_KEY=replace-with-a-long-random-value
PUBLIC_BASE_URL=http://localhost:8000

# PostgreSQL stores verification records, messages, reports, and audit events.
# Use a separate least-privilege application user in every environment.
DATABASE_URL=postgresql+psycopg://verisure:change-me@localhost:5432/verisure

# Redis backs asynchronous WhatsApp delivery, timeout, reminder, and retry jobs.
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=verification
RQ_DEFAULT_TIMEOUT_SECONDS=300

# Keep fixture mode until Twilio WhatsApp is approved and webhook hosting is ready.
# In live mode, PUBLIC_BASE_URL must be a public HTTPS URL registered with Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VALIDATE_SIGNATURE=true
TWILIO_STATUS_CALLBACK_PATH=/webhooks/twilio/status
TWILIO_INBOUND_WEBHOOK_PATH=/webhooks/twilio/whatsapp

# LLM is used only for constrained extraction/follow-up drafting. It cannot make
# a hiring decision, bypass consent, or resolve a discrepancy.
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=

# State-machine timing. Failed deliveries or expired responses escalate to HR.
VERIFICATION_MAX_SEND_ATTEMPTS=3
VERIFICATION_REMINDER_AFTER_HOURS=24
VERIFICATION_RESPONSE_TIMEOUT_HOURS=48
