# Copy this file to .env. Fixture mode is the only safe default for the demo.
SOURCE_MODE=fixture
DATABASE_PATH=data/verisure.db
# Optional live database backend; use the server-only Postgres pooler URL.
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
INTERNAL_API_KEY=replace-with-a-long-random-value
PUBLIC_BASE_URL=http://localhost:8000

# Keep fixture mode until Twilio WhatsApp is approved and webhook hosting is ready.
# In live mode, PUBLIC_BASE_URL must be a public HTTPS URL registered with Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURE=true

# Automatic HR PDF delivery after a verification completes. Keep these server-side.
# For Gmail, use smtp.gmail.com, port 587, and a Gmail app password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# The completed comparison PDF is delivered here exactly once per case.
HR_RECIPIENT_EMAIL=neerajchormale39@gmail.com

# Optional AI support. The input assistant repairs natural-language WhatsApp replies
# (for example, "January 2022") before the deterministic validation is applied.
# It never fills in missing employment facts or makes a verification decision.
AI_INPUT_ASSIST_ENABLED=true
# Leave blank for the OpenAI Responses API. Set these three values for another
# OpenAI-compatible provider, such as OpenCode Go / MiMo-V2.5.
AI_INPUT_BASE_URL=
AI_INPUT_API_KEY=
# Or use GROQ_API_KEY for Groq; it takes precedence over OPENAI_API_KEY.
GROQ_API_KEY=
AI_INPUT_MODEL=
# Used for schema-constrained extraction from images/scanned PDFs. AI_INPUT_MODEL
# falls back to this value when it is unset.
LLM_MODEL=
OPENAI_API_KEY=
